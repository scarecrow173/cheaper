{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "includes": [
      "scripts/**/*.mjs",
      "benchmarks/**/*.mjs",
      "benchmarks/**/*.json",
      "packages/**/*.json",
      "!**/dist",
      "!**/node_modules",
      "!benchmarks/results"
    ]
  }
}
