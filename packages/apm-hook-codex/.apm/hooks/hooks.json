{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^([Rr][Ee][Aa][Dd]|[Gg][Rr][Ee][Pp]|[Bb][Aa][Ss][Hh]|[Pp][Oo][Ww][Ee][Rr][Ss][Hh][Ee][Ll][Ll])$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh ./cheaper.sh hook pre-tool-use --target codex"
          }
        ]
      }
    ]
  }
}
