#!/bin/sh
# version 固定 Release acquisition。契約: DESIGN-034zQkHD65kAeG9xVGSoFX。
set -eu
fail() { printf '%s\n' "cheaper launcher: $*" >&2; exit 1; }
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
system=$(uname -s)
machine=$(uname -m)
case "$system" in Linux) os=linux ;; Darwin) os=darwin ;; MINGW*|MSYS*|CYGWIN*) os=win32 ;; *) fail "unsupported OS: $system" ;; esac
case "$machine" in x86_64|amd64) arch=x64 ;; aarch64|arm64) arch=arm64 ;; *) fail "unsupported arch: $machine" ;; esac
if [ "$os" = win32 ]; then
  exe="$self_dir/cli/bin/win32-x64/cheaper.exe"
else
  exe="$self_dir/cli/bin/$os-$arch/cheaper"
fi
# sibling は既存 platform 契約を優先（取得の supported target と区別）。
if [ -f "$exe" ]; then
  if head -c 44 "$exe" 2>/dev/null | grep -q 'version https://git-lfs'; then
    fail "$exe is a Git LFS pointer. Install git-lfs and run git lfs pull, or reinstall the APM package."
  fi
  exec "$exe" "$@"
fi
if [ "$os" = win32 ]; then
  native_arch=${PROCESSOR_ARCHITEW6432:-${PROCESSOR_ARCHITECTURE:-$machine}}
  case "$native_arch" in AMD64|amd64|x86_64) arch=x64 ;; *) fail "unsupported Windows native arch: $native_arch" ;; esac
fi
platform="$os-$arch"
case "$platform" in linux-x64|linux-arm64) name=cheaper; asset="cheaper-$platform" ;; win32-x64) name=cheaper.exe; asset=cheaper-windows-x64.exe ;; *) fail "unsupported acquisition platform: $platform; provide a local sibling executable." ;; esac
[ -f "$self_dir/cli/version.json" ] || fail "missing cli/version.json; reinstall the package with version metadata or provide a local sibling executable (Copilot JSON deploy limitation)."
# JSON grammar は外側 whitespace と単一 version string のみ。string 内を正規化しない。
version=$(awk '
  { text = text $0 "\n" }
  END {
    n=split(text,a,"\"");
    if (n==5 && a[1] ~ /^[[:space:]]*\{[[:space:]]*$/ && a[2]=="version" &&
        a[3] ~ /^[[:space:]]*:[[:space:]]*$/ && a[5] ~ /^[[:space:]]*\}[[:space:]]*$/) printf "%s",a[4];
  }' "$self_dir/cli/version.json")
printf '%s\n' "$version" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?(\+[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$' || fail "invalid version metadata; expected a single safe SemVer version."
base=${CHEAPER_RELEASE_BASE_URL:-https://github.com/scarecrow173/cheaper/releases/download}
base=${base%/}
# HTTP は literal loopback のみ。redirect は例外なく HTTPS-only。
printf '%s\n' "$base" | grep -Eq '^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$|^http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$' || fail "invalid Release origin; use a trusted HTTPS mirror or loopback HTTP stub."
cache_root=${CHEAPER_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:?HOME is required}/.cache}/cheaper}
if [ "$os" = win32 ]; then
  case "$cache_root" in [A-Za-z]:*) cache_root=$(cygpath -u "$cache_root") ;; esac
fi
case "$cache_root" in /*) ;; *) fail "cache root must be an absolute path (CHEAPER_CACHE_DIR)." ;; esac
command -v realpath >/dev/null 2>&1 || fail "realpath is required to resolve the cache boundary."
cache_root=$(realpath -m "$cache_root") || fail "cannot resolve cache directory."
case "$cache_root/" in "$self_dir/"*) fail "cache must be outside the deployed hook directory; set CHEAPER_CACHE_DIR." ;; esac
parent="$cache_root/$version"
key="$parent/$platform"
lock="$parent/.$platform.lock"
stage=
owns_lock=0
cleanup() {
  [ -z "$stage" ] || rm -rf -- "$stage"
  [ "$owns_lock" -eq 0 ] || rm -rf -- "$lock"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
mkdir -p -- "$parent" 2>/dev/null || fail "cannot write cache directory $cache_root; set CHEAPER_CACHE_DIR to a writable user directory."
waited=0
while ! mkdir -- "$lock" 2>/dev/null; do
  [ -d "$lock" ] || fail "cannot create acquisition lock in cache $parent."
  [ "$waited" -lt 120 ] || fail "acquisition lock timed out at $lock; verify the owner process has stopped, then remove its lock and staging directory."
  sleep 1
  waited=$((waited + 1))
done
owns_lock=1
printf '%s\n' "$$" > "$lock/owner" || fail "cannot write acquisition lock owner."
hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print tolower($1)}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print tolower($1)}'
  else fail "install sha256sum or shasum for checksum verification."
  fi
}
verify() {
  candidate="$1/$name"
  sums="$1/SHA256SUMS"
  [ -f "$candidate" ] && [ -f "$sums" ] || fail "cache requires both executable and SHA256SUMS; remove the incomplete key and preseed the verified pair."
  [ "$(wc -c < "$sums")" -le 65536 ] || fail "checksum manifest exceeds 64KiB; remove the invalid cache key."
  expected=$(LC_ALL=C awk -v asset="$asset" '
    { hash=substr($0,1,64); file=substr($0,67);
      if (length($0)<67 || length(hash)!=64 || hash ~ /[^0-9A-Fa-f]/ || substr($0,65,2)!="  " || file !~ /^[A-Za-z0-9._-]+$/) invalid=1;
      if (file==asset) { count++; selected=tolower(hash) }
    }
    END { if(invalid || count!=1) exit 1; print selected }
  ' "$sums") || fail "invalid checksum manifest (missing or duplicate $asset); preseed the same-tag SHA256SUMS pair."
  actual=$(hash_file "$candidate") || fail "cannot hash cached executable."
  [ "$actual" = "$expected" ] || fail "checksum mismatch; remove $key and preseed the correct same-tag executable and SHA256SUMS."
  chmod u+x "$candidate" 2>/dev/null || fail "cannot set executable permission in cache."
  observed=$("$candidate" --version </dev/null 2>/dev/null) || fail "cached executable version probe failed; remove $key and preseed the correct executable."
  # Windows native --version は CRLF を出す場合がある。
  cr=$(printf '\r')
  observed=${observed%"$cr"}
  [ "$observed" = "$version" ] || fail "wrong executable version (expected $version); remove $key and preseed its matching Release pair."
}
download() {
  command -v curl >/dev/null 2>&1 || fail "curl is required for acquisition; install curl or offline preseed the executable and SHA256SUMS."
  if ! curl --fail --silent --location --connect-timeout 15 --max-time 120 --proto '=http,https' --proto-redir '-all,https' --output "$2" "$base/v$version/$1" 2>/dev/null; then
    fail "download of $1 for v$version failed; check the tagged Release/SHA256SUMS, HTTPS proxy or trusted mirror, or offline preseed the pair."
  fi
}
if [ -e "$key" ]; then
  [ -d "$key" ] || fail "cache key is not a directory: $key."
  verify "$key"
else
  stage=$(mktemp -d "$parent/.$platform.staging.XXXXXXXX") || fail "cannot create cache staging directory."
  download SHA256SUMS "$stage/SHA256SUMS"
  download "$asset" "$stage/$name"
  verify "$stage"
  [ ! -e "$key" ] || fail "cache key appeared during acquisition; refusing to overwrite $key."
  mv -- "$stage" "$key" || fail "cannot atomically publish cache key $key."
  stage=
fi
cleanup
owns_lock=0
trap - EXIT HUP INT TERM
exec "$key/$name" "$@"
