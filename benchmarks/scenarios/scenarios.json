{
  "schemaVersion": 2,
  "fixtureRevision": "seeded-v2",
  "scenarios": [
    {
      "id": "single-simple-tool-call",
      "title": "Single simple tool call",
      "arms": [
        "workflow",
        "direct-filesystem",
        "direct-worker-tool-call",
        "run-logging-off",
        "run-logging-file",
        "run-logging-debug"
      ],
      "armBase": {
        "run-logging-off": "direct-worker-tool-call",
        "run-logging-file": "direct-worker-tool-call",
        "run-logging-debug": "direct-worker-tool-call"
      },
      "armEnv": {
        "run-logging-file": { "CHEAPER_LOG": "info" },
        "run-logging-debug": { "CHEAPER_LOG": "debug" }
      },
      "files": {
        "README.md": "seeded fixture: direct file read\n"
      },
      "workflow": {
        "schemaVersion": 1,
        "inputs": {},
        "jobs": {
          "read": {
            "kind": "tool",
            "tool": "read",
            "input": {
              "path": "README.md"
            }
          }
        },
        "outputs": {
          "text": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "read",
              "path": "/content/0/text"
            }
          }
        }
      },
      "manual": {
        "kind": "direct-filesystem",
        "path": "README.md",
        "toolCallPath": "README.md",
        "tasks": ["Read README.md and summarize its contents"]
      },
      "comparisons": [
        {
          "left": "workflow",
          "right": "direct-worker-tool-call",
          "reduction": { "left": "retainedBytes", "right": "retainedBytes" }
        }
      ]
    },
    {
      "id": "independent-fanout-worker-fanin",
      "title": "Independent fan-out and Worker fan-in",
      "workflowMaxJobs": 3,
      "arms": ["workflow", "direct-worker-sequence"],
      "responseProfiles": ["compact"],
      "responseDelayMs": 0,
      "files": {
        "left.txt": "seeded left partition\n",
        "right.txt": "seeded right partition\n"
      },
      "workflow": {
        "schemaVersion": 1,
        "inputs": {},
        "jobs": {
          "left": {
            "kind": "tool",
            "tool": "read",
            "input": {
              "path": "left.txt"
            }
          },
          "right": {
            "kind": "tool",
            "tool": "read",
            "input": {
              "path": "right.txt"
            }
          },
          "summary": {
            "kind": "worker",
            "worker": "bulk-reader",
            "needs": ["left", "right"],
            "input": {
              "task": "Combine the independent tool results",
              "hints": [
                {
                  "$from": "left",
                  "path": "/content/0/text"
                },
                {
                  "$from": "right",
                  "path": "/content/0/text"
                }
              ]
            }
          }
        },
        "outputs": {
          "summary": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "summary",
              "path": "/summary"
            }
          }
        }
      },
      "manual": {
        "kind": "direct-worker-sequence",
        "readPaths": ["left.txt", "right.txt"],
        "tasks": ["Combine the independent tool results"]
      },
      "comparisons": [
        {
          "left": "workflow",
          "right": "direct-worker-sequence",
          "reduction": { "left": "retainedBytes", "right": "retainedBytes" }
        }
      ]
    },
    {
      "id": "tool-to-worker-chain",
      "title": "Tool to Worker chain",
      "arms": ["workflow", "direct-worker-sequence"],
      "files": {
        "source.txt": "seeded source material for analysis\n"
      },
      "workflow": {
        "schemaVersion": 1,
        "inputs": {},
        "jobs": {
          "read": {
            "kind": "tool",
            "tool": "read",
            "input": {
              "path": "source.txt"
            }
          },
          "analyze": {
            "kind": "worker",
            "worker": "bulk-reader",
            "input": {
              "task": "Analyze the material read by the prior tool call",
              "hints": [
                {
                  "$from": "read",
                  "path": "/content/0/text"
                }
              ]
            }
          }
        },
        "outputs": {
          "readText": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "read",
              "path": "/content/0/text"
            }
          },
          "summary": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "analyze",
              "path": "/summary"
            }
          }
        }
      },
      "manual": {
        "kind": "direct-worker-sequence",
        "readPath": "source.txt",
        "tasks": ["Analyze the material read by the prior tool call"]
      },
      "comparisons": [
        {
          "left": "workflow",
          "right": "direct-worker-sequence",
          "reduction": { "left": "retainedBytes", "right": "retainedBytes" }
        }
      ]
    },
    {
      "id": "process-and-analysis",
      "title": "Process and analysis workflow",
      "arms": ["workflow", "direct-worker-sequence"],
      "processPolicy": {
        "maxConcurrent": 1,
        "tasks": {
          "emit": {
            "command": ["{fixtureChild}", "--fixture-child", "emit"],
            "inputs": [],
            "outputs": []
          }
        }
      },
      "workflow": {
        "schemaVersion": 1,
        "inputs": {},
        "jobs": {
          "process": {
            "kind": "tool",
            "tool": "process",
            "input": {
              "task": "emit"
            }
          },
          "analyze": {
            "kind": "worker",
            "worker": "bulk-reader",
            "input": {
              "task": "Analyze process output",
              "hints": [
                {
                  "$from": "process",
                  "path": "/details/stdout/text"
                }
              ]
            }
          }
        },
        "outputs": {
          "processOutput": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "process",
              "path": "/details/stdout/text"
            }
          },
          "summary": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "analyze",
              "path": "/summary"
            }
          }
        }
      },
      "manual": {
        "kind": "direct-worker-sequence",
        "child": { "mode": "emit" },
        "tasks": ["Analyze process output"]
      },
      "comparisons": [
        {
          "left": "workflow",
          "right": "direct-worker-sequence",
          "reduction": { "left": "retainedBytes", "right": "retainedBytes" }
        }
      ]
    },
    {
      "id": "large-intermediate-process-analysis",
      "title": "Large intermediate process output and analysis",
      "arms": ["workflow", "direct-worker-sequence"],
      "processPolicy": {
        "maxConcurrent": 1,
        "tasks": {
          "emit": {
            "command": ["{fixtureChild}", "--fixture-child", "emit"],
            "inputs": [],
            "outputs": [],
            "env": { "CHEAPER_BENCH_CHILD_BYTES": "32768" }
          }
        }
      },
      "workflow": {
        "schemaVersion": 1,
        "inputs": {},
        "jobs": {
          "process": {
            "kind": "tool",
            "tool": "process",
            "input": {
              "task": "emit"
            }
          },
          "analyze": {
            "kind": "worker",
            "worker": "bulk-reader",
            "input": {
              "task": "Analyze the large process output",
              "hints": [
                {
                  "$from": "process",
                  "path": "/details/stdout/text"
                }
              ]
            }
          }
        },
        "outputs": {
          "processOutput": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "process",
              "path": "/details/stdout/text"
            }
          },
          "summary": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "analyze",
              "path": "/summary"
            }
          }
        }
      },
      "manual": {
        "kind": "direct-worker-sequence",
        "child": { "mode": "emit", "bytes": 32768 },
        "tasks": ["Analyze the large process output"]
      },
      "comparisons": [
        {
          "left": "workflow",
          "right": "direct-worker-sequence",
          "reduction": { "left": "retainedBytes", "right": "retainedBytes" }
        }
      ]
    },
    {
      "id": "dynamic-vs-saved-workflow",
      "title": "Dynamic workflow versus saved reusable workflow",
      "arms": ["dynamic-workflow", "saved-workflow", "direct-worker-sequence"],
      "files": {},
      "savedWorkflowFile": "saved-workflow.json",
      "workflow": {
        "schemaVersion": 1,
        "inputs": {},
        "jobs": {
          "analyze": {
            "kind": "worker",
            "worker": "bulk-reader",
            "input": {
              "task": "Analyze the reusable saved workflow fixture"
            }
          }
        },
        "outputs": {
          "summary": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "analyze",
              "path": "/summary"
            }
          }
        }
      },
      "manual": {
        "kind": "direct-worker-sequence",
        "tasks": ["Analyze the reusable saved workflow fixture"]
      },
      "comparisons": [
        {
          "left": "dynamic-workflow",
          "right": "saved-workflow",
          "reduction": {
            "left": "definitionGenerationMs",
            "right": "definitionGenerationMs"
          }
        }
      ]
    },
    {
      "id": "definition-vs-compact-interface",
      "title": "Full workflow definition versus compact interface discovery",
      "arms": ["workflow", "full-definition", "compact-interface"],
      "files": {
        "README.md": "interface discovery fixture\n"
      },
      "workflow": {
        "schemaVersion": 1,
        "inputs": {},
        "jobs": {
          "read": {
            "kind": "tool",
            "tool": "read",
            "input": {
              "path": "README.md"
            }
          }
        },
        "outputs": {
          "text": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "read",
              "path": "/content/0/text"
            }
          }
        }
      },
      "manual": {
        "kind": "interface-discovery"
      },
      "comparisons": [
        {
          "left": "full-definition",
          "right": "compact-interface",
          "reduction": {
            "left": "definitionReadBytes",
            "right": "parentVisibleInterfaceBytes"
          }
        }
      ]
    },
    {
      "id": "route-resolve-and-rewrite",
      "title": "Route resolve dry-run versus hook rewrite verdict",
      "arms": ["route-resolve", "route-rewrite"],
      "route": {
        "name": "bench-route",
        "match": { "command": ["benchrun"] },
        "command": "benchrun --fixture-child emit",
        "grant": "bench-child",
        "childMode": "emit",
        "childBytes": 512,
        "passthroughEnv": []
      },
      "armExpect": {
        "route-resolve": {
          "envelopeOk": true,
          "resolve": {
            "matched": true,
            "route": "bench-route",
            "viability": "runnable",
            "executable": "benchrun"
          }
        },
        "route-rewrite": {
          "exitCode": 0,
          "route": { "rewritten": true }
        }
      },
      "comparisons": [
        {
          "left": "route-resolve",
          "right": "route-rewrite",
          "reduction": { "left": "wallTimeMs", "right": "wallTimeMs" }
        }
      ]
    },
    {
      "id": "route-routed-exec",
      "title": "Routed exec versus direct child spawn",
      "arms": ["route-run", "direct-child-exec"],
      "route": {
        "name": "bench-route",
        "match": { "command": ["benchrun"] },
        "command": "benchrun --fixture-child emit",
        "grant": "bench-child",
        "childMode": "emit",
        "childBytes": 1024,
        "passthroughEnv": []
      },
      "armExpect": {
        "route-run": {
          "exitCode": 0,
          "route": { "condenseFired": false, "truncated": false }
        },
        "direct-child-exec": {
          "exitCode": 0,
          "route": { "childOutputBytes": 1024 }
        }
      },
      "comparisons": [
        {
          "left": "route-run",
          "right": "direct-child-exec",
          "reduction": { "left": "childOutputBytes", "right": "childOutputBytes" }
        }
      ]
    },
    {
      "id": "route-condense-and-refetch",
      "title": "Route output condense and log refetch",
      "arms": ["route-run", "route-logs", "direct-child-exec"],
      "route": {
        "name": "bench-route",
        "match": { "command": ["benchrun"] },
        "command": "benchrun --fixture-child emit",
        "grant": "bench-child",
        "childMode": "emit",
        "childBytes": 16384,
        "tokenThreshold": 1,
        "maxOutputBytes": 4096,
        "passthroughEnv": []
      },
      "fakeStream": {
        "fixture": {
          "name": "condense-session",
          "sessions": [
            {
              "steps": [{ "finish": { "text": "{\"summary\":\"seeded condense summary\"}" } }]
            }
          ]
        }
      },
      "armExpect": {
        "route-run": {
          "exitCode": 0,
          "route": { "condenseFired": true, "truncated": true }
        },
        "route-logs": {
          "envelopeOk": true,
          "exitCode": 0,
          "route": { "condenseFired": true, "truncated": true },
          "metrics": { "logRefetches": 1 }
        },
        "direct-child-exec": {
          "exitCode": 0,
          "route": { "childOutputBytes": 16384 }
        }
      },
      "comparisons": [
        {
          "left": "route-run",
          "right": "route-logs",
          "reduction": { "left": "originalTokens", "right": "logRefetchBytes" }
        }
      ]
    },
    {
      "id": "worker-failure-modes",
      "title": "Worker failure mode matrix (provider error, timeout, postprocess failure)",
      "arms": [
        "direct-provider-error",
        "workflow-provider-error",
        "direct-worker-timeout",
        "workflow-worker-timeout",
        "direct-postprocess-failure",
        "workflow-postprocess-failure"
      ],
      "armBase": {
        "direct-provider-error": "direct-worker-tool-call",
        "workflow-provider-error": "workflow",
        "direct-worker-timeout": "direct-worker-tool-call",
        "workflow-worker-timeout": "workflow",
        "direct-postprocess-failure": "direct-worker-tool-call",
        "workflow-postprocess-failure": "workflow"
      },
      "policy": {
        "execution": { "timeout": "500ms" },
        "output": { "repairAttempts": 1 }
      },
      "workflow": {
        "schemaVersion": 1,
        "inputs": {},
        "jobs": {
          "analyze": {
            "kind": "worker",
            "worker": "bulk-reader",
            "input": {
              "task": "Analyze the failure fixture"
            }
          }
        },
        "outputs": {
          "summary": {
            "schema": {
              "type": "string"
            },
            "value": {
              "$from": "analyze",
              "path": "/summary"
            }
          }
        }
      },
      "manual": {
        "kind": "direct-worker-sequence",
        "tasks": ["Analyze the failure fixture"]
      },
      "armFakeStream": {
        "direct-provider-error": {
          "fixture": {
            "name": "provider-error",
            "sessions": [
              {
                "steps": [
                  {
                    "error": {
                      "status": 500,
                      "retryable": false,
                      "message": "seeded provider error"
                    }
                  }
                ]
              }
            ]
          }
        },
        "workflow-provider-error": {
          "fixture": {
            "name": "provider-error",
            "sessions": [
              {
                "steps": [
                  {
                    "error": {
                      "status": 500,
                      "retryable": false,
                      "message": "seeded provider error"
                    }
                  }
                ]
              }
            ]
          }
        },
        "direct-worker-timeout": {
          "fixture": {
            "name": "hang-session",
            "sessions": [{ "steps": ["hang"] }]
          }
        },
        "workflow-worker-timeout": {
          "fixture": {
            "name": "hang-session",
            "sessions": [{ "steps": ["hang"] }]
          }
        },
        "direct-postprocess-failure": {
          "fixture": {
            "name": "schema-violations",
            "sessions": [
              { "steps": [{ "finish": { "text": "not valid worker output" } }] },
              { "steps": [{ "finish": { "text": "still not valid worker output" } }] }
            ]
          }
        },
        "workflow-postprocess-failure": {
          "fixture": {
            "name": "schema-violations",
            "sessions": [
              { "steps": [{ "finish": { "text": "not valid worker output" } }] },
              { "steps": [{ "finish": { "text": "still not valid worker output" } }] }
            ]
          }
        }
      },
      "armExpect": {
        "direct-provider-error": {
          "envelopeOk": false,
          "errorCode": "PROVIDER_FAILURE"
        },
        "workflow-provider-error": {
          "envelopeOk": false,
          "errorCode": "TOOL_EXECUTION_FAILURE"
        },
        "direct-worker-timeout": {
          "envelopeOk": false,
          "errorCode": "TIMEOUT"
        },
        "workflow-worker-timeout": {
          "envelopeOk": false,
          "errorCode": "TIMEOUT"
        },
        "direct-postprocess-failure": {
          "envelopeOk": false,
          "errorCode": "INVALID_OUTPUT"
        },
        "workflow-postprocess-failure": {
          "envelopeOk": false,
          "errorCode": "TOOL_EXECUTION_FAILURE"
        }
      },
      "comparisons": [
        {
          "left": "direct-provider-error",
          "right": "workflow-provider-error",
          "reduction": { "left": "wallTimeMs", "right": "wallTimeMs" }
        }
      ]
    },
    {
      "id": "route-child-nonzero-exit",
      "title": "Route child nonzero exit mirror",
      "arms": ["route-run", "direct-child-exec"],
      "route": {
        "name": "bench-route",
        "match": { "command": ["benchrun"] },
        "command": "benchrun --fixture-child fail",
        "grant": "bench-child",
        "childMode": "fail",
        "passthroughEnv": []
      },
      "armExpect": {
        "route-run": {
          "exitCode": 7,
          "route": { "condenseFired": false }
        },
        "direct-child-exec": {
          "exitCode": 7
        }
      }
    }
  ]
}
