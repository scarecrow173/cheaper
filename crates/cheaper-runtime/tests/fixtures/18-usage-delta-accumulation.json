{
  "name": "usage_delta_accumulation",
  "description": "複数 usage_delta が accumulator に畳み込まれる(3 call 分の合算)",
  "sessions": [
    {
      "steps": [
        { "usage_delta": { "input": 100, "output": 10 } },
        { "turn": {} },
        { "usage_delta": { "input": 50, "output": 5, "cacheRead": 20, "cacheWrite": 10 } },
        { "turn": {} },
        { "usage_delta": { "input": 60, "output": 6 } },
        { "turn": {} },
        { "finish": { "text": "{\"ok\":true}" } }
      ]
    }
  ],
  "expect": {
    "status": "ok",
    "result": { "ok": true },
    "meta": {
      "usage": {
        "input": 210,
        "output": 21,
        "cacheRead": 20,
        "cacheWrite": 10,
        "totalTokens": 261
      },
      "turns": 3
    }
  }
}
