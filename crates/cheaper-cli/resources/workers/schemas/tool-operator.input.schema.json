{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task"],
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "context": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "focus": {
          "type": "array",
          "items": { "type": "string" }
        },
        "maxFindings": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
