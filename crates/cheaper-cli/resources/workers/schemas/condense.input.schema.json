{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["logRef", "originalTokens", "command"],
  "properties": {
    "logRef": {
      "type": "string",
      "pattern": "^[0-9]+-[0-9]+-[0-9a-f]+$"
    },
    "originalTokens": {
      "type": "integer",
      "minimum": 0
    },
    "command": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
