{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.(/|$))(?!.*/\\.\\.(/|$)).+$"
    },
    "lines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "relevantFiles", "suggestedReads", "openQuestions"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail", "confidence", "locations"],
        "properties": {
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "$ref": "#/$defs/path" },
                "lines": { "$ref": "#/$defs/lines" },
                "excerpt": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "relevantFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "reason": { "type": "string" }
        }
      }
    },
    "suggestedReads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "lines": { "$ref": "#/$defs/lines" },
          "reason": { "type": "string" }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
