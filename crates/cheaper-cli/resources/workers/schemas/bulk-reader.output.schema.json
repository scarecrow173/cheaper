{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.(/|$))(?!.*/\\.\\.(/|$)).+$"
    },
    "lines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "relevantFiles", "suggestedReads", "openQuestions"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail", "confidence", "locations"],
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "detail": { "type": "string", "maxLength": 1200 },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "locations": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "$ref": "#/$defs/path" },
                "lines": { "$ref": "#/$defs/lines" },
                "excerpt": { "type": "string", "maxLength": 600 }
              }
            }
          }
        }
      }
    },
    "relevantFiles": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "reason": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "suggestedReads": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "lines": { "$ref": "#/$defs/lines" },
          "reason": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "maxLength": 300 }
    }
  }
}
