{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.(/|$))(?!.*/\\.\\.(/|$)).+$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["task"],
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" }
    },
    "hints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "maxFindings": { "type": ["integer", "null"], "minimum": 1 }
  }
}
