{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.(/|$))(?!.*/\\.\\.(/|$)).+$"
    },
    "lines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["location", "commit", "exitCode", "truncation", "note"]
        },
        "path": { "$ref": "#/$defs/path" },
        "lines": { "$ref": "#/$defs/lines" },
        "commit": { "type": "string" },
        "exitCode": { "type": "integer" },
        "truncated": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings", "unresolved", "nextActions"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed", "blocked"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail", "evidence"],
        "properties": {
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "grantRequests": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executable"],
        "properties": {
          "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "argvHint": {
            "type": "array",
            "maxItems": 256,
            "items": { "type": "string", "maxLength": 4096 }
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          }
        }
      }
    }
  }
}
