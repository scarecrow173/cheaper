{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.(/|$))(?!.*/\\.\\.(/|$)).+$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "targets"],
  "properties": {
    "task": { "type": "string", "minLength": 1, "maxLength": 6000 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "intent"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "intent": { "type": "string", "enum": ["create", "modify", "create-or-modify"] },
          "notes": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/path" }
    },
    "constraints": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 300 }
    }
  }
}
