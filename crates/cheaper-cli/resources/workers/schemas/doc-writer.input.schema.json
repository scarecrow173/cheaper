{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.(/|$))(?!.*/\\.\\.(/|$)).+$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "documentType", "targets"],
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "documentType": {
      "type": "string",
      "enum": [
        "adr",
        "spec",
        "design",
        "plan",
        "task",
        "readme",
        "guide",
        "reference",
        "release-notes",
        "other"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "intent"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "intent": { "type": "string", "enum": ["create", "modify", "create-or-modify"] },
          "notes": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "facts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
