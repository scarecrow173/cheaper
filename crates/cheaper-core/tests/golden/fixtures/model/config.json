              "openai/*"
            ]
          }
        }
      },
      "files": {
        "user/models.yaml": "version: 1\noverrides:\n  openai/gpt-5-mini: low\npreferences:\n  low: [anthropic/claude-haiku-4-5, \"openai/*\"]\n"
      },
      "name": "user models.yaml",
      "opts": {
        "projectDir": "proj/.cheaper",
        "userConfigDir": "user"
      }
    },
    {
      "expected": {
