        "user/models.yaml": "version: 1\noverrides:\n  openai/gpt-5-mini: low\n  anthropic/claude-sonnet-4: medium\npreferences:\n  low: [\"openai/*\"]\n  medium: [a/x]\n"
      },
      "name": "merge user then project",
      "opts": {
        "projectDir": "proj/.cheaper",
        "userConfigDir": "user"
